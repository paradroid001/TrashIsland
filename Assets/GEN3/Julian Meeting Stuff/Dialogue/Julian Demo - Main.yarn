<<elseif visited ("SelectedGlass") == true && visited ("GlassExplain") == false>>
    <<jump GlassExplain>>
<<elseif visited ("SelectedPlastic") == true&& visited ("PlasticExplain") == false>>
    <<jump PlasticExplain>>
<<endif>>
